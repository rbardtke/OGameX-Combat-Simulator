{
  "manifest_version": 2,
  "name": "OGame Combat Simulator",
  "version": "1.3.0",
  "description": "Fast OGame combat simulator powered by Rust and WebAssembly",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_action": {
    "default_title": "OGame Combat Simulator"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
  "web_accessible_resources": ["pkg/*", "img/*"]
}
